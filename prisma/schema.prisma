// The Warm Sweep — Prisma schema.
//
// Design notes:
//  - Multi-tenant from day one. Every tenant-owned row carries `orgId` and is
//    only ever read through the org-scoped client in src/lib/tenancy.ts.
//  - Org model supports the reseller hierarchy now (Agency -> Client) even
//    though the reseller UI lands in M8 — cheaper to model the bones once.
//  - `Lead` carries the agent-facing fields (originalInquiry, statedGoal,
//    consent, status) so the state machine in M3 doesn't need a re-migration.
//  - pgvector is enabled from M2; no vector columns exist yet in M1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use the pooled connection (DATABASE_URL) — right for
  // serverless. Migrations use a DIRECT (non-pooled) connection (DIRECT_URL) so
  // `prisma migrate deploy` can take its advisory lock reliably; through the
  // pgbouncer pooler that lock intermittently times out on cold compute. The
  // vercel-build script falls back to DATABASE_URL when DIRECT_URL is unset, so
  // builds never break before the env var is configured.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

enum OrgType {
  AGENCY // a reseller that owns Client orgs
  CLIENT // an operator workspace that owns leads
}

enum Role {
  AGENCY_ADMIN // manages an agency and all its client orgs
  CLIENT_ADMIN // manages a single client org
  MEMBER // operates within a client org
}

model Org {
  id        String  @id @default(cuid())
  type      OrgType @default(CLIENT)
  name      String
  slug      String  @unique

  // Reseller hierarchy. A CLIENT org may belong to an AGENCY org.
  parentAgencyId String?
  parentAgency   Org?    @relation("AgencyClients", fields: [parentAgencyId], references: [id], onDelete: SetNull)
  clients        Org[]   @relation("AgencyClients")

  // White-label branding (reseller layer, M8). When set, the client's users see
  // this brand instead of "The Warm Sweep".
  brandName    String?
  brandLogoUrl String?
  brandColor   String?
  fromDomain   String?

  // §4: a custom sending domain cannot enter active sending until SPF + DMARC
  // verify. Cached from the DNS check so send-time enforcement is cheap.
  domainAuthOk        Boolean   @default(false)
  domainAuthCheckedAt DateTime?

  // M8 per-seat billing (what the agency charges this client).
  clientPriceCents Int    @default(0)
  seats            Int    @default(1)
  billingStatus    String @default("active") // active | trial | past_due | paused | canceled
  canceledAt       DateTime? // §9 self-serve cancellation timestamp

  // §10 customer-type / vertical tag (set at onboarding), for privacy-clean
  // aggregate pattern-learning across the outcome log. Never customer-facing.
  vertical String?

  // M9: what one client is worth to this coach. Set once during the first sweep;
  // stamps each imported lead's dealValueCents and powers the "dormant pipeline"
  // reveal + recovered-revenue math. 0 until the operator tells us.
  avgClientValueCents Int @default(0)

  // §8 guarantee override (X calls / 30 days). Null → the single default in
  // lib/guarantee.ts; the threshold is never hard-coded anywhere else.
  guaranteeCalls Int?

  // CAN-SPAM: a real physical mailing address shown in every email (enforced M5).
  mailingAddress String?

  memberships  Membership[]
  invitations  Invitation[]
  leads        Lead[]
  leadImports  LeadImport[]
  suppressions SuppressionEntry[]
  auditLogs    AuditLog[]

  // M2: voice + memory + drafting
  voiceProfile     VoiceProfile?
  voiceSamples     VoiceSample[]
  memoryEmbeddings MemoryEmbedding[]
  drafts           Draft[]
  agentRuns        AgentRun[]

  // M3: mailboxes + messages + conversations
  mailboxes     Mailbox[]
  messages      Message[]
  conversations Conversation[]

  // M4: calendar + bookings
  calendarConnections CalendarConnection[]
  bookings            Booking[]
  // Slack webhook for "call booked" notifications (§6); encrypted at rest.
  slackWebhookEnc String?

  // M6: self-improvement
  insights Insight[]
  learning OrgLearning?

  // M7: lead source integrations (importers behind the LeadSource adapter)
  leadSources LeadSourceConnection[]

  // §10: append-only outcome log for aggregate pattern-learning.
  outcomeEvents OutcomeEvent[]

  // C5: in-app notification center (org-scoped activity alerts).
  notifications Notification[]

  // M17 autopilot (always-on): opt-in per workspace, default OFF so existing
  // behavior is unchanged and nobody is surprised by auto-spend or auto-sends.
  // The nightly autopilot job acts only on orgs that turned a capability on.
  autopilotSync  Boolean @default(false) // poll connected lead sources on a schedule → ingest fresh leads
  autopilotDraft Boolean @default(false) // auto-draft fresh NEW leads (queued for approval; never auto-sent unreviewed)
  autopilotSend  Boolean @default(false) // auto-send drafts a human ALREADY approved (approval gate preserved)
  autopilotApprove Boolean @default(false) // auto-APPROVE + send high-confidence drafts (skips the queue; low-confidence still waits)

  // Stripe billing (set by checkout + webhook). billingStatus above mirrors the
  // Stripe subscription state for quick reads/gating.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentAgencyId])
  @@index([type])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String? // null for OAuth-only users (added later)
  emailVerified DateTime?
  image         String?

  memberships   Membership[]
  authTokens    AuthToken[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Platform integration credentials set in-app (Settings → Integrations) instead
// of env vars — so connecting Stripe/email/etc. is a few clicks, no redeploy.
// Values are encrypted at rest; reads fall back to the matching env var.
model AppConfig {
  key       String   @id
  valueEnc  String
  updatedAt DateTime @updatedAt
}

// Fixed-window rate limiter (e.g. login attempts per IP/email). Keyed by an
// arbitrary string; count resets when the window rolls over.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// A pending invitation for someone to join an org with a given role. Only the
// token hash is stored; the raw token lives in the emailed accept link.
model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orgId, email])
  @@index([orgId])
}

// Single-use, expiring tokens for account email flows (password reset + email
// verification). Only the SHA-256 hash of the token is stored; the raw token
// lives only in the emailed link.
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "PASSWORD_RESET" | "EMAIL_VERIFY"
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// A user's membership in an org, with a role. The join is the unit of access.
model Membership {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   Role   @default(CLIENT_ADMIN)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────────────────────────────────────

// The per-lead state machine. M1 only sets NEW; later milestones drive it.
enum LeadStatus {
  NEW
  RESEARCHED
  DRAFTED
  AWAITING_APPROVAL
  SCHEDULED
  SENT
  AWAITING_REPLY
  REPLIED
  NEGOTIATING
  BOOKED // terminal (success)
  // branches
  BOUNCED
  OPTED_OUT
  DO_NOT_CONTACT
  COOLED // re-queue
  CLOSED_LOST
}

// Lawful basis for contact (GDPR/CASL). The import gate requires a prior
// relationship — this records why contacting the lead is permitted.
enum ConsentBasis {
  PRIOR_INQUIRY // they reached out to us before (default for reactivation)
  EXISTING_CUSTOMER
  EXPLICIT_CONSENT
  LEGITIMATE_INTEREST
  UNKNOWN
}

model Lead {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // identity
  email     String
  firstName String?
  lastName  String?
  company   String?
  phone     String?

  // agent-facing memory seeds (populated by the research step in M2/M3)
  originalInquiry String? @db.Text // what they first asked about
  statedGoal      String? @db.Text // the goal the agent infers/records
  toneRead        String? // e.g. "warm, direct"
  bestChannel     String? // e.g. "email"

  status LeadStatus @default(NEW)

  // compliance
  consentBasis ConsentBasis @default(PRIOR_INQUIRY)
  region       String? // for region-specific rules (GDPR/CASL)
  priorContact Boolean      @default(true) // import gate must attest this
  lastTouchAt  DateTime? // last time we contacted them (for cooldown)
  coolDownUntil DateTime?

  // M11: pre-flight list hygiene (§3). Every imported address is verified before
  // it can ever be sent to. INVALID is never sendable (and is suppressed). RISKY
  // is held out of the initial warmup ramp. verifiedAt drives 30-day re-checks.
  reachability Reachability @default(REACHABLE)
  verifiedAt   DateTime?
  verifyReason String? // why it landed risky/invalid (role account, no MX, …)

  source     String? // "csv", "hubspot", ...
  importId   String?
  import     LeadImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  // M2: objections the agent has read off this lead's history (structured memory)
  objections String[] @default([])

  // M2 relations
  drafts           Draft[]
  memoryEmbeddings MemoryEmbedding[]
  agentRuns        AgentRun[]

  // M3 relations
  messages      Message[]
  conversation  Conversation?

  // M4: estimated deal value (drives the "recovered revenue" KPI) + bookings
  dealValueCents Int       @default(0)
  bookings       Booking[]

  // M6: A/B holdout cohort. HOLDOUT gets baseline copy/timing so improvement
  // is measured against a control, not asserted.
  cohort Cohort @default(TREATMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A lead's email is unique within an org (dedupe on import), not globally.
  @@unique([orgId, email])
  @@index([orgId, status])
  @@index([importId])
}

// A batch record of one import, retained for audit + the column mapping used.
model LeadImport {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String // sweep name, e.g. "Cold leads · Q1 2024"
  source      String  @default("csv")
  fileName    String?
  columnMap   Json // { field: csvHeader } mapping chosen in the UI
  totalRows   Int     @default(0)
  importedRows Int    @default(0)
  skippedRows Int     @default(0)
  priorContactAttested Boolean @default(false) // M5/§9 gate

  leads Lead[]

  createdAt DateTime @default(now())

  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Compliance + audit (tables exist now; enforcement wired in M5)
// ─────────────────────────────────────────────────────────────────────────────

enum SuppressionReason {
  OPTED_OUT
  BOUNCED
  COMPLAINED
  MANUAL
  DO_NOT_CONTACT
  INVALID // failed pre-flight verification (§3) — bad syntax / no MX
}

// M11: pre-flight verification verdict for an imported address (§3 list hygiene).
enum Reachability {
  REACHABLE // safe to send
  RISKY // deliverable but lower-quality (role account, catch-all, parked) — warmup holdout
  INVALID // never sendable (bad syntax, no MX) — hard-suppressed
}

// Global per-org suppression list. An email here must never be contacted.
model SuppressionEntry {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email  String
  reason SuppressionReason @default(MANUAL)
  note   String?

  createdAt DateTime @default(now())

  @@unique([orgId, email])
  @@index([orgId])
}

// Append-only audit trail. The agent's own decisions log to a separate
// agent_runs table introduced in M2; this is for human/system actions.
model AuditLog {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId   String? // user id, or null for system
  action    String // e.g. "lead.import", "org.create"
  targetType String?
  targetId  String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// M2 — Voice profile, semantic memory (pgvector), drafting, agent audit
// ─────────────────────────────────────────────────────────────────────────────

// The operator's "Warm Sweep voice", learned from past emails and editable.
// One per org. Structured memory layer (a) at the org level.
model VoiceProfile {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  tone          String  @default("Warm, direct, no fluff")
  sentenceLength String @default("Short. Punchy.")
  emojiUse      String  @default("Rare, never salesy")
  greeting      String  @default("Hi {{firstName}},")
  signOff       String  @default("— {{operator}}")
  signatureMove String  @default("Ask, don't pitch")
  summary       String? @db.Text // a paragraph the agent uses as a style anchor

  // Draft rules (editable per org). Defaults encode the §5 "ask-don't-pitch" rules.
  doRules   String[] @default([])
  dontRules String[] @default([])

  sampleCount Int    @default(0)
  source      String @default("default") // "default" | "learned" | "edited"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A raw past email from the operator, used to learn voice + retrieved as a
// style exemplar when drafting. Its embedding lives in MemoryEmbedding.
model VoiceSample {
  id      String  @id @default(cuid())
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subject String?
  body    String  @db.Text
  createdAt DateTime @default(now())

  @@index([orgId])
}

// Semantic memory layer (b). One row per embedded chunk; the `embedding`
// column is a pgvector column managed via raw SQL (see lib/memory).
enum MemoryKind {
  VOICE_SAMPLE // operator's voice
  LEAD_REPLY // something a lead wrote back
  OBJECTION // an objection snippet
  INQUIRY // the lead's original inquiry
}

model MemoryEmbedding {
  id      String     @id @default(cuid())
  orgId   String
  org     Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind    MemoryKind
  leadId  String?
  lead    Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourceId String? // e.g. VoiceSample.id this chunk came from
  content String     @db.Text
  metadata Json?

  // pgvector column. Declared Unsupported so Prisma creates/drops it but we
  // read/write it through $queryRaw/$executeRaw (vector(1024) = voyage-3 dim).
  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  @@index([orgId, kind])
  @@index([leadId])
}

// A generated message awaiting human approval (v1 default). Groups its variants.
enum DraftStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED // a newer generation replaced it
}

model Draft {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status DraftStatus @default(PENDING_APPROVAL)

  variants        DraftVariant[]
  selectedVariantId String?

  // Final, possibly human-edited copy at approval time.
  finalSubject String?
  finalBody    String? @db.Text
  editedByHuman Boolean @default(false)

  approvedById String?
  approvedAt   DateTime?
  rejectedReason String?

  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  // M3: the outbound message(s) produced when this draft was approved + sent.
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([leadId])
}

model DraftVariant {
  id      String @id @default(cuid())
  draftId String
  draft   Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  index       Int
  angle       String // e.g. "goal-led", "curiosity", "direct"
  subject     String
  body        String @db.Text
  openingLine String // first line — tracked for self-improvement analytics (M6)
  confidence  Float  @default(0)
  rationale   String @db.Text

  // M9: how closely this variant tracks the operator's learned voice (0..1) and
  // a real phrase it echoes from their own past emails — surfaced at approval so
  // the coach can SEE it sounds like them, not just be told.
  voiceMatch Float?
  voiceEcho  String?

  createdAt DateTime @default(now())

  @@index([draftId])
}

// Audit row for every agent step (§3). Makes the loop fully inspectable:
// input summary, structured decision, tokens, cost, latency.
enum AgentStep {
  RESEARCH
  DRAFT
  REPLY
  REFLECT
  VOICE_LEARN
}

model AgentRun {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  step     AgentStep
  provider String // "anthropic" | "stub"
  model    String

  inputSummary String  @db.Text
  decision     Json? // the structured tool output
  rationale    String? @db.Text
  confidence   Float?

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costUsd          Float @default(0)
  latencyMs        Int   @default(0)

  status String  @default("OK") // "OK" | "ERROR"
  error  String? @db.Text

  drafts Draft[]

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([leadId])
}

// ─────────────────────────────────────────────────────────────────────────────
// M3 — Mailboxes, messages, conversations (the send + reply loop)
// ─────────────────────────────────────────────────────────────────────────────

enum MailboxProviderKind {
  GMAIL
  MICROSOFT // stubbed until M7
  SIMULATION // offline dev/demo mailbox — sends + replies are simulated
}

enum MailboxStatus {
  CONNECTED
  DISCONNECTED
  PAUSED // auto-paused on bounce/complaint threshold (M5) or by the operator
}

// An operator's sending identity. Tokens are stored ENCRYPTED at rest
// (AES-256-GCM via lib/crypto); plaintext never touches the DB.
model Mailbox {
  id       String              @id @default(cuid())
  orgId    String
  org      Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider MailboxProviderKind
  email    String
  status   MailboxStatus       @default(CONNECTED)

  // Encrypted OAuth material (null for SIMULATION).
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiry     DateTime?
  // For Gmail incremental sync (history API) / delta cursors.
  syncCursor String?
  lastSyncAt DateTime?

  // Deliverability rails (§9). Effective daily cap = min(dailyCap, warmup ramp).
  dailyCap  Int      @default(40)
  sentToday Int      @default(0)
  capResetAt DateTime?

  // Hourly throttle (human-like pacing).
  hourlyCap    Int       @default(8)
  sentThisHour Int       @default(0)
  hourResetAt  DateTime?

  // Domain warmup: gradual volume ramp for new sending domains.
  warmupStartedAt DateTime?

  // Bounce/complaint tracking → auto-pause over threshold.
  sentTotal      Int @default(0)
  bounceCount    Int @default(0)
  complaintCount Int @default(0)
  pausedReason   String?

  // §4 circuit breaker: set when the bounce/complaint hard-stop trips. Sending
  // cannot resume until the operator re-scrubs the list (§3) — one bad list must
  // not be allowed to keep burning the domain on a naive un-pause.
  requiresRescrub Boolean @default(false)

  messages      Message[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@index([orgId])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  RECEIVED // inbound
  FAILED
}

model Message {
  id        String @id @default(cuid())
  orgId     String
  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  direction MessageDirection
  status    MessageStatus    @default(QUEUED)

  // Threading + provider identifiers (Gmail messageId / threadId).
  providerMessageId String?
  threadId          String?
  inReplyTo         String?

  fromEmail String
  toEmail   String
  subject   String
  body      String @db.Text

  // Inbound classification (§6: parse out auto-replies + bounces).
  isAutoReply Boolean @default(false)
  isBounce    Boolean @default(false)
  isOptOut    Boolean @default(false)

  // For OUTBOUND, the approved draft this was sent from.
  draftId String?
  draft   Draft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)

  sentAt     DateTime?
  receivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId, leadId])
  @@index([conversationId])
  @@index([threadId])
}

enum ConversationStatus {
  ACTIVE // back-and-forth in progress
  AWAITING_REPLY // we sent, waiting on them
  NEEDS_REVIEW // a reply draft is queued for approval
  BOOKED // call booked (M4)
  CLOSED
}

// One email thread per lead. Powers the Conversations inbox + thread view.
model Conversation {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId    String  @unique
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  threadId String?
  subject  String
  status   ConversationStatus @default(AWAITING_REPLY)

  // Whether the agent auto-advances this thread (per-sequence "autonomous" flag,
  // §3/§7). v1 default is false → reply drafts go to the approval queue.
  autopilot Boolean @default(false)

  // §5 confidence gate: why this thread needs careful human attention (hostile,
  // off-script, unverifiable question). Null = a clear, confidently-read reply.
  reviewReason String?

  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  messages Message[]
  booking  Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// M4 — Calendar connections + bookings (the "books the call" payoff)
// ─────────────────────────────────────────────────────────────────────────────

enum CalendarProviderKind {
  CALCOM
  CALENDLY // stubbed until M7
  SIMULATION // offline deterministic availability + booking
  LINK // plain booking-link fallback (§6): we don't read events, just send the link
}

enum CalendarStatus {
  CONNECTED
  DISCONNECTED
}

// An org's scheduling connection. apiKey is ENCRYPTED at rest (lib/crypto).
model CalendarConnection {
  id       String               @id @default(cuid())
  orgId    String
  org      Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider CalendarProviderKind
  status   CalendarStatus       @default(CONNECTED)

  apiKeyEnc   String? // encrypted Cal.com API key (null for SIMULATION/LINK)
  eventTypeId String? // Cal.com event type to book against
  bookingLink String? // public booking URL (used by LINK + offered in copy)
  timezone    String  @default("UTC")

  // §6 booking quality: business-hours window (in `timezone`), buffer between
  // calls, and whether off-hours/weekend bookings are allowed at all.
  businessStartHour Int     @default(9) // 0–23, inclusive
  businessEndHour   Int     @default(17) // 0–23, exclusive (last start < this)
  bufferMin         Int     @default(0)
  allowOutOfHours   Boolean @default(false)
  slotDurationMin   Int     @default(30)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum BookingStatus {
  HELD // tentative hold
  CONFIRMED // booked — the call is on the calendar
  SHOWED // the lead attended (success)
  NO_SHOW // booked but didn't attend
  RESCHEDULED // moved to a new time
  CANCELED
}

// §10 — Outcome-data capture (the durable asset). An append-only log of what
// actually converts cold leads: subject line, message variant, send timing, the
// org's vertical, and the outcome. Powers future cadence/subject optimization and
// per-vertical defaults. AGGREGATE pattern-learning only — never a surface that
// exposes one customer's data to another; contacts are never moved between orgs.
enum OutcomeKind {
  SENT
  REPLIED
  QUALIFIED
  BOOKED
  SHOWED
  NO_SHOW
  OPTED_OUT
}

model OutcomeEvent {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId String?

  kind         OutcomeKind
  subject      String? // the subject line that was sent (for subject-line learning)
  variantAngle String? // which draft angle (goal-led / curiosity / direct / …)
  sendHour     Int? // hour-of-day the send went out (0–23), for timing learning
  vertical     String? // org's customer-type tag, snapshotted
  valueCents   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([orgId, kind])
  @@index([vertical, kind])
}

// A booked call — the terminal success of the agent loop.
model Booking {
  id                   String              @id @default(cuid())
  orgId                String
  org                  Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId               String
  lead                 Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId       String?             @unique
  conversation         Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  calendarConnectionId String?
  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)

  status        BookingStatus @default(CONFIRMED)
  startsAt      DateTime
  endsAt        DateTime
  attendeeEmail String
  attendeeName  String?
  meetingUrl    String?
  providerEventId String? // Cal.com booking uid (for dedupe on webhook)
  source        String        @default("agent") // "agent" | "link" | "webhook"

  // Snapshot of the lead's value at booking time → recovered-revenue KPI.
  valueCents Int @default(0)

  // §6 no-show defense: timezone snapshot + reminder accounting. reminderCount
  // tracks which timed reminders have fired (0=none, 1=24h, 2=1h).
  timezone      String?
  reminderCount Int       @default(0)
  lastReminderAt DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([leadId])
  @@index([orgId, status, startsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// M6 — Self-improvement (bounded + auditable)
// ─────────────────────────────────────────────────────────────────────────────

// A/B holdout cohorts. TREATMENT = agent-optimized copy/timing; HOLDOUT =
// baseline control. Reflection compares the two to measure real lift.
enum Cohort {
  TREATMENT
  HOLDOUT
}

// What the agent taught itself. Each insight is a metric-justified proposal the
// operator can apply or veto (§8). Adjustments only ever touch copy/timing.
enum InsightKind {
  PROMOTE_OPENER // an opening line that out-performs
  RETIRE_PHRASE // an opening line that under-performs
  SHIFT_SENDTIME // a better send hour
  TIGHTEN_FOLLOWUP // adjust the follow-up gap
  AB_RESULT // holdout vs treatment readout (informational)
}

enum InsightStatus {
  PROPOSED
  APPLIED
  VETOED
}

model Insight {
  id     String        @id @default(cuid())
  orgId  String
  org    Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind   InsightKind
  status InsightStatus @default(PROPOSED)

  title  String
  body   String  @db.Text
  metric String // the number that justifies it, e.g. "2.3× more replies"

  // The concrete, machine-applicable change (e.g. { bestSendHour: 9 } or
  // { retirePhrase: "just checking in" }). Applied into OrgLearning on accept.
  payload Json?

  appliedById String?
  appliedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

// The agent's applied, tuned settings — the only knobs self-improvement turns.
// Never touches sending identity or compliance logic (§8/§13).
model OrgLearning {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  bestSendHour    Int? // 0–23, learned highest-reply send hour
  retiredPhrases  String[] @default([]) // opening lines to avoid
  promotedOpeners String[] @default([]) // opening lines to favor
  followUpGapDays Int      @default(3)

  lastReflectionAt DateTime?
  version          Int       @default(1) // bumps each applied change ("v14")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// M7 — Lead source integrations (importers behind the LeadSource adapter)
// ─────────────────────────────────────────────────────────────────────────────

enum LeadSourceKind {
  CSV
  HUBSPOT
  GOOGLE_SHEETS
  MAILCHIMP
  KAJABI
}

enum LeadSourceStatus {
  CONNECTED
  DISCONNECTED
}

// A connected importer. The api key/token is ENCRYPTED at rest; `config` holds
// provider-specific settings (sheet id, Mailchimp list id, Mailchimp dc, etc.).
model LeadSourceConnection {
  id       String           @id @default(cuid())
  orgId    String
  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider LeadSourceKind
  status   LeadSourceStatus @default(CONNECTED)

  apiKeyEnc String?
  config    Json? // { sheetId?, listId?, dc?, subdomain? }

  lastSyncAt   DateTime?
  lastImported Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, provider])
  @@index([orgId])
}

// ── C5: In-app notification center ───────────────────────────────────────────
// Org-scoped activity alerts (a lead replied, a call booked, a draft is ready,
// a send failed, an opt-out). Surfaced via the topbar bell. userId is reserved
// for future per-user targeting; today notifications are org-wide (userId null).
enum NotificationKind {
  REPLY_RECEIVED
  CALL_BOOKED
  DRAFT_READY
  SEND_FAILED
  OPTED_OUT
  BOUNCED
}

enum NotificationStatus {
  UNREAD
  READ
}

model Notification {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   NotificationKind
  status NotificationStatus @default(UNREAD)

  title     String
  body      String?
  actionUrl String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, status, createdAt])
  @@index([userId])
}
