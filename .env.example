# ─────────────────────────────────────────────────────────────────────────────
# The Warm Sweep — environment variables
# Copy to .env and fill in. NEVER commit .env. All secrets are server-side only.
#
# Most integration credentials below (Stripe, Resend email, Gmail/Microsoft OAuth,
# Anthropic/Voyage AI) can ALSO be connected in-app, no redeploy, by an admin at
# Account → Integrations. Those are stored encrypted at rest and take precedence
# over the matching env var here; env stays as a fallback / for local dev.
# (DATABASE_URL, DIRECT_URL, AUTH_SECRET, NEXTAUTH_URL, ENCRYPTION_KEY,
# CRON_SECRET, and SENTRY_DSN remain env-only — they're needed at boot or on the
# client error boundary.)
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Postgres; pgvector enabled from M2) --------------------------
DATABASE_URL="postgresql://warmsweep:warmsweep@localhost:5432/warmsweep?schema=public"

# --- Auth.js (NextAuth) -----------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app (used for callbacks)
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Encryption (OAuth tokens at rest — used from M3) -----------------------
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# --- Anthropic (server-side only; used from M2) -----------------------------
ANTHROPIC_API_KEY=""
# Copywriting model (interactive drafting) and the fast model used for bulk
# cron/autopilot drafting. Sonnet is the default — top-tier copy at ~1/5 the
# Opus price; set ANTHROPIC_MODEL explicitly only if you want to override.
# Autopilot drafting additionally rides Message Batches automatically when a
# key is set (50% token discount; drafts land on the next cron pass).
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"

# --- Embeddings (Voyage AI; semantic memory — used from M2) -----------------
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3"

# --- Gmail OAuth (mailbox send/read — used from M3) -------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cal.com (booking — used from M4) ---------------------------------------
CALCOM_CLIENT_ID=""
CALCOM_CLIENT_SECRET=""

# --- Microsoft 365 / Outlook (mailbox — used from M7) -----------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- Cal.com webhook signature (optional; verifies BOOKING_CREATED posts) ----
# The webhook URL already carries a per-org signed token; this adds Cal.com's
# x-cal-signature-256 HMAC check on top when set.
CAL_WEBHOOK_SECRET=""
# Calendly + lead-source (HubSpot/Sheets/Mailchimp/Kajabi) keys are stored
# per-org in the DB (encrypted), entered in the Connections UI — not here.

# --- Compliance (CAN-SPAM physical address shown in every email — M5) -------
# Org-level value lives in the DB; this is only a fallback for local dev.
DEFAULT_MAILING_ADDRESS=""

# --- Self-improvement nightly job (M6) --------------------------------------
# Shared secret for the cron endpoints (/api/jobs/*) — Bearer token. Set this in
# production so only Vercel Cron can trigger the always-on jobs.
CRON_SECRET=""

# --- Database: direct (non-pooled) connection for migrations ----------------
# Prisma migrate takes an advisory lock that times out through the pgbouncer
# pooler on cold compute. Set this to the NON-pooled connection string (same as
# DATABASE_URL but with "-pooler" removed from the host). Falls back to
# DATABASE_URL when unset.
DIRECT_URL=""

# --- Transactional email (password reset, verify, invites, receipts) --------
# Resend API key + a verified sender. Unset → emails are logged, not delivered.
RESEND_API_KEY=""
EMAIL_FROM="The Warm Sweep <onboarding@resend.dev>"

# --- Billing (Stripe subscriptions) -----------------------------------------
# Unset → billing is not enforced and the app stays open (for local/dev setup).
# Once STRIPE_SECRET_KEY + STRIPE_PRICE_ID are set, the app is PAID-ONLY: every
# workspace without an active subscription is walled behind /billing until it
# subscribes (the Stripe webhook flips it to active). Existing orgs that were
# already "active" are grandfathered; brand-new orgs start "incomplete".
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""              # the default subscription price (→ CONTINUITY tier)
# Maps each purchased Stripe price → the entitlement tier it unlocks. JSON object;
# STRIPE_PRICE_ID falls back to CONTINUITY when a price isn't listed here. Tiers:
# FRONT_END | OTO1 | CONTINUITY | PERFORMANCE | RESELLER | AGENCY.
# e.g. {"price_297":"CONTINUITY","price_97":"PERFORMANCE","price_497":"RESELLER","price_997":"AGENCY"}
STRIPE_PRICE_TIERS=""
# One-time (mode=payment) prices for the front of the funnel. On payment the
# webhook grants the tier (lifetime access, no subscription).
STRIPE_PRICE_FRONT_END=""       # $27 Founding tripwire (one-time)
STRIPE_PRICE_BUMP=""            # +$17 backlog bump — raises the sweep cap 100→500
STRIPE_PRICE_OTO1=""            # $197 Own-It license (one-time)
# Performance plan ($97/mo + fee per booked call): a base recurring price + a
# metered usage price. Also add the base price to STRIPE_PRICE_TIERS → PERFORMANCE.
STRIPE_PRICE_PERFORMANCE_BASE=""      # $97/mo licensed base
STRIPE_PRICE_PERFORMANCE_METERED=""   # metered per-booked-call price
STRIPE_WEBHOOK_SECRET=""        # signing secret for /api/webhooks/stripe
STRIPE_PLAN_NAME="The Warm Sweep"
STRIPE_PLAN_PRICE_LABEL=""      # e.g. "$297/mo" (display only)

# --- Explore / test mode -----------------------------------------------------
# Off by default: customers only see real connections + real data. Set to 1 to
# reveal the internal exploration tools (load sample data, the simulated "test"
# inbox/calendar, and the no-API-key lead-source fallback) for your own testing.
EXPLORE_MODE=""

# --- Signup abuse guards (optional) -----------------------------------------
# Extra disposable/throwaway email domains to block at signup, beyond the
# built-in list. Comma-separated. e.g. DISPOSABLE_EMAIL_DOMAINS="foo.com,bar.io"
DISPOSABLE_EMAIL_DOMAINS=""

# --- Private-beta comps (optional) ------------------------------------------
# Comma-separated emails granted a free trial on signup, so invited testers skip
# the paid-only paywall. Add/remove anytime (no deploy). Leave empty in normal
# operation. e.g. TRIAL_COMP_EMAILS="a@x.com,b@y.com"
TRIAL_COMP_EMAILS=""

# --- Error monitoring (optional) --------------------------------------------
# Sentry DSN. Unset → errors are still captured in Vercel runtime logs.
SENTRY_DSN=""

# --- Platform superadmins ---------------------------------------------------
# Comma-separated emails that can reach /admin (go-live readiness + the cross-org
# console). Distinct from a workspace's own admins. e.g. SUPERADMIN_EMAILS="you@co.com"
SUPERADMIN_EMAILS=""
